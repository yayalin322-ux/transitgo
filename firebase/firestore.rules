rules_version = '2';

// Every read/write the app needs goes through the Functions HTTPS API (Admin SDK,
// which bypasses these rules entirely). Direct client access to Firestore is not
// part of this design, so it's all denied here — safe by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
