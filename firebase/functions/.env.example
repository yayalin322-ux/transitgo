# Copy to .env (same directory) before `firebase deploy` or `firebase emulators:start`.
# Firebase Functions v2 loads this file into process.env automatically — same variable
# names as transitgo-server's .env, so nothing else needs to change.

# 管理者權杖 —— 發佈公告 / 看回報時用（Authorization: Bearer <這串>）
ADMIN_TOKEN=

# TDX（自動抓台鐵/高鐵營運異常 + YouBike 輪詢）留空則兩者都停用
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# YouBike 輪詢城市清單（逗號分隔），留空預設只抓 Taipei,NewTaipei
BIKE_CITIES=Taipei,NewTaipei,Taoyuan,Hsinchu,HsinchuCounty,MiaoliCounty,Taichung,ChanghuaCounty,Chiayi,ChiayiCounty,Tainan,Kaohsiung,PingtungCounty,YilanCounty,HualienCounty,TaitungCounty,KinmenCounty

# 異常恢復正常時是否也發一則「已恢復」公告
ANNOUNCE_RECOVERY=true

# APNs 推播（沒有 Apple 開發者帳號就全部留空 → 進 DRY_RUN，只記 log 不送）
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false
