# 複製成 .env 後填入

# 伺服器
PORT=8787
DB_PATH=./data/transitgo.db

# 管理者權杖 —— 發佈公告 / 看回報時用（Authorization: Bearer <這串>）
ADMIN_TOKEN=change-me-to-a-long-random-string

# TDX（自動抓台鐵/高鐵營運異常）留空則不啟用自動公告
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# TDX 給多模式路線規劃引擎單獨用的一組憑證（獨立額度，不跟上面共用 5次/分鐘）
# 留空則路線引擎退回使用上面那組 TDX_CLIENT_ID/SECRET
TDX_ROUTING_CLIENT_ID=
TDX_ROUTING_CLIENT_SECRET=

# 自動公告輪詢間隔（分鐘）
ALERT_POLL_MINUTES=3
# 異常恢復正常時是否也發一則「已恢復」公告
ANNOUNCE_RECOVERY=true

# APNs 推播（沒有 Apple 開發者帳號就全部留空 → 進 DRY_RUN，只記 log 不送）
APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=tw.yayalin.TransitGo
# true = 正式環境, false = 開發環境
APNS_PRODUCTION=false
