# 複製成 .env 後填入

# 伺服器
PORT=8787
DB_PATH=./data/transitgo.db

# Supabase Postgres —— 設了這個就會改用 Postgres（不再受 Render 部署清空影響），留空則用上面的 SQLite
DATABASE_URL=

# 管理者權杖 —— 發佈公告 / 看回報時用（Authorization: Bearer <這串>）
ADMIN_TOKEN=change-me-to-a-long-random-string

# Email 驗證碼（地標留言、店家驗證）借用 yayalin.com 網站的寄信機制，不用自己接寄信服務。
# 兩個都是網站本來就公開的值（publishable key，不是機密），留空就用程式碼裡寫死的預設值——
# 只有要測試不同的 Supabase 專案才需要覆寫。要用這個功能，yayalin.com 那邊要先執行過
# supabase/add_verify_email_code_rpc.sql。
SITE_SUPABASE_URL=
SITE_SUPABASE_ANON_KEY=

# TDX（自動抓台鐵/高鐵營運異常）留空則不啟用自動公告
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# TDX 給多模式路線規劃引擎單獨用的一組憑證（獨立額度，不跟上面共用 5次/分鐘）
# 留空則路線引擎退回使用上面那組 TDX_CLIENT_ID/SECRET
TDX_ROUTING_CLIENT_ID=
TDX_ROUTING_CLIENT_SECRET=

# Routing graph artifact storage (Supabase Storage, S3-compatible) —— 留空則路線圖不會
# 持久化，每次 Render restart/redeploy 都要重新呼叫 POST /v1/admin/routing/rebuild。
# 從 Supabase Dashboard → Project Settings → Storage → S3 Connection 取得。
# 這組 key 有完整 Storage 讀寫權限，只能放在 Render 環境變數 / 本機 .env，絕對不能進 Git、
# 不能印進 log、不能回傳給任何 API、不能放進 iOS app。
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=transitgo-routing-graph

# 自動公告輪詢間隔（分鐘）
ALERT_POLL_MINUTES=3
# 異常恢復正常時是否也發一則「已恢復」公告
ANNOUNCE_RECOVERY=true

# APNs 推播（沒有 Apple 開發者帳號就全部留空 → 進 DRY_RUN，只記 log 不送）
APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=tw.yayalin.TransitGo
# true = 正式環境, false = 開發環境
APNS_PRODUCTION=false
