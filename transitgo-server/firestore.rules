rules_version = '2';
// The app never talks to Firestore directly: only our backend does, through the Admin SDK (which is not subject to
// these rules). So no client — a browser, an app, anyone with the project id — may read or write anything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
