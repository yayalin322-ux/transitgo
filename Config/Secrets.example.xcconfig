// Copy this file to Secrets.xcconfig and fill in your own TDX credentials.
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
// Get a key at https://tdx.transportdata.tw/user/dataservice/key
TDX_CLIENT_ID = your-client-id
TDX_CLIENT_SECRET = your-client-secret

// 選填：自架 transitgo-server 的主機名（不含 http(s)://），例如 transit.example.com 或 localhost:8787
BACKEND_HOST =

// 分享連結使用的網域（選填，例如 yayalin.com/app）。留空則連結用後端網址。要先確認該網域的 /app/s/ 代理已上線。
SHARE_BASE_HOST =
